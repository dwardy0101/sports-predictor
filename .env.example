# --- Required: Telegram (free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional, free tiers ---
# Odds from many bookmakers (500 credits/month free): https://the-odds-api.com
ODDS_API_KEY=
# Dota 2 + CS2 schedules (free plan): https://pandascore.co
PANDASCORE_TOKEN=

# --- Optional, paid (pay-as-you-go): AI analyst that reads injuries/news ---
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. claude-haiku-5-5 is far cheaper (~40x) if budget matters.
LLM_MODEL=

# --- Tuning ---
WINDOW_HOURS=4
# Comma list. Remove any you don't want.
SPORTS=nba,wnba,basketball,football,tennis,dota2,cs2
# Only alert when edge vs market >= this % (0 = alert on everything)
MIN_EDGE_PCT=0
